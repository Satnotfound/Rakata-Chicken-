{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated RAKATA owner or staff user profile isolated by UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Authentication user UID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254,
          "description": "Verified Google account email address."
        },
        "displayName": {
          "type": "string",
          "maxLength": 120,
          "description": "Display name from Google account."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when user profile was first created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when user profile was last updated."
        }
      },
      "required": ["uid", "email", "displayName", "createdAt", "updatedAt"]
    },
    "OwnerSettings": {
      "title": "OwnerSettings",
      "description": "Private owner preferences such as optional 4-6 digit dashboard lock PIN.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "ownerPin": {
          "type": "string",
          "minLength": 4,
          "maxLength": 6,
          "pattern": "^[0-9]{4,6}$",
          "description": "Optional 4-6 digit numeric lock PIN for quick screen lock, or null when disabled."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the last settings update."
        }
      },
      "required": ["ownerUid", "ownerPin", "updatedAt"]
    },
    "AdminMarker": {
      "title": "AdminMarker",
      "description": "Server-validated admin marker document keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Admin user UID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254,
          "description": "Admin email address."
        },
        "grantedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "UID of the admin who granted access."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when admin access was granted."
        }
      },
      "required": ["uid", "email", "grantedBy", "createdAt"]
    },
    "FinanceEntry": {
      "title": "FinanceEntry",
      "description": "RAKATA business income or expense ledger entry persisted in Cloud Firestore.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Document ID matching the ledger entry identifier."
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the owner who created this entry."
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Transaction date in YYYY-MM-DD format."
        },
        "type": {
          "type": "string",
          "enum": ["income", "expense"],
          "description": "Whether the ledger entry is income or expense."
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Business accounting category."
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["cash", "transfer", "qris"],
          "description": "Payment channel used for the transaction."
        },
        "amount": {
          "type": "number",
          "description": "Positive transaction amount in Indonesian Rupiah (IDR)."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Human-readable transaction description."
        },
        "source": {
          "type": "string",
          "enum": ["manual", "order"],
          "description": "Origin of the entry (manual ledger entry or storefront order)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-modified timestamp."
        }
      },
      "required": [
        "id",
        "ownerUid",
        "date",
        "type",
        "category",
        "paymentMethod",
        "amount",
        "description",
        "source",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile documents restricted to the owner or verified admin."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/OwnerSettings" },
      "description": "Owner-only private settings subcollection (e.g., settings document)."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminMarker" },
      "description": "Trusted admin marker documents managed only by bootstrapped admin."
    },
    "/financeEntries/{entryId}": {
      "schema": { "$ref": "#/entities/FinanceEntry" },
      "description": "Financial ledger entries scoped by ownerUid and accessible to verified owners or bootstrapped admin."
    }
  }
}
