rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isEmailVerified() && request.auth.token.email == 'razanputra0111@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin()
        || (isEmailVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isOwner(userId) {
      return isEmailVerified() && request.auth.uid == userId;
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.uid is string && isValidId(data.uid) && data.uid == userId
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOwnerSettings(data, userId) {
      return data.keys().hasAll(['ownerUid', 'ownerPin', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'ownerPin', 'updatedAt'])
        && data.ownerUid is string && isValidId(data.ownerUid) && data.ownerUid == userId
        && (
          data.ownerPin == null
          || (data.ownerPin is string && data.ownerPin.size() >= 4 && data.ownerPin.size() <= 6 && data.ownerPin.matches('^[0-9]{4,6}$'))
        )
        && data.updatedAt is timestamp;
    }

    function isValidAdminMarker(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'grantedBy', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'grantedBy', 'createdAt'])
        && data.uid is string && isValidId(data.uid) && data.uid == userId
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.grantedBy is string && isValidId(data.grantedBy)
        && data.createdAt is timestamp;
    }

    function isValidFinanceEntry(data, entryId) {
      return data.keys().hasAll([
          'id',
          'ownerUid',
          'date',
          'type',
          'category',
          'paymentMethod',
          'amount',
          'description',
          'source',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'ownerUid',
          'date',
          'type',
          'category',
          'paymentMethod',
          'amount',
          'description',
          'source',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string && isValidId(data.id) && data.id == entryId
        && data.ownerUid is string && isValidId(data.ownerUid)
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.type in ['income', 'expense']
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 80
        && data.paymentMethod in ['cash', 'transfer', 'qris']
        && (data.amount is int || data.amount is float) && data.amount > 0 && data.amount <= 1000000000
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 500
        && data.source in ['manual', 'order']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---

    // User Profiles (PII strictly restricted to owner or admin; no blanket list)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;

      allow create: if isEmailVerified()
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isEmailVerified()
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && (isOwner(userId) || isAdmin())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'updatedAt'])
        );

      allow delete: if isValidId(userId) && isAdmin();

      // Private Owner Settings Subcollection (PIN lock preference)
      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && docId == 'settings' && isOwner(userId);
        allow list: if false;

        allow create: if isEmailVerified()
          && isValidId(userId)
          && isValidId(docId)
          && docId == 'settings'
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidOwnerSettings(incoming(), userId)
          && incoming().ownerUid == request.auth.uid
          && incoming().updatedAt == request.time;

        allow update: if isEmailVerified()
          && isValidId(userId)
          && isValidId(docId)
          && docId == 'settings'
          && isOwner(userId)
          && isValidOwnerSettings(incoming(), userId)
          && incoming().ownerUid == existing().ownerUid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['ownerPin', 'updatedAt']);

        allow delete: if isValidId(userId) && isValidId(docId) && docId == 'settings' && isOwner(userId);
      }
    }

    // Trusted Admin Markers (only bootstrapped admin can list/manage)
    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isBootstrappedAdmin());
      allow list: if isBootstrappedAdmin();

      allow create: if isBootstrappedAdmin()
        && isValidId(userId)
        && isValidAdminMarker(incoming(), userId)
        && incoming().grantedBy == request.auth.uid
        && incoming().createdAt == request.time;

      allow update: if false;
      allow delete: if isValidId(userId) && isBootstrappedAdmin();
    }

    // Financial Ledger Entries (owner-scoped, plus bootstrapped admin oversight)
    match /financeEntries/{entryId} {
      allow get: if isValidId(entryId)
        && isEmailVerified()
        && (existing().ownerUid == request.auth.uid || isAdmin());

      // Zero get()/exists() in list rule to satisfy Cost-Optimization Clause
      allow list: if isEmailVerified()
        && (isBootstrappedAdmin() || resource.data.ownerUid == request.auth.uid);

      allow create: if isEmailVerified()
        && isValidId(entryId)
        && isValidFinanceEntry(incoming(), entryId)
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isEmailVerified()
        && isValidId(entryId)
        && isValidFinanceEntry(incoming(), entryId)
        && (existing().ownerUid == request.auth.uid || isAdmin())
        && incoming().id == existing().id
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || incoming().diff(existing()).affectedKeys().hasOnly([
            'date',
            'type',
            'category',
            'paymentMethod',
            'amount',
            'description',
            'source',
            'updatedAt'
          ])
        );

      allow delete: if isValidId(entryId)
        && isEmailVerified()
        && (existing().ownerUid == request.auth.uid || isAdmin());
    }
  }
}
